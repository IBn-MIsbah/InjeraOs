# ==============================================================================
# InjeraOS Server Production Environment Configuration Template
# For Render Web Service or Docker deployment
# ==============================================================================

# Application Environment & Network Port
NODE_ENV=production
PORT=3000

# Canonical Web / Client Origin for CORS (e.g., your Vercel frontend URL)
# Supports comma-separated origins: https://your-app.vercel.app,http://localhost:5173
CLIENT_ORIGIN=https://your-app.vercel.app

# PostgreSQL Authoritative Database Connection URL
# On Render: Use the Internal Database URL from your Render PostgreSQL instance
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://injera_user:injera_secure_pass_2026@dpg-xxxx.render.com/injera_prod?sslmode=require

# Database Credentials (for local Docker Compose)
POSTGRES_USER=injera_user
POSTGRES_PASSWORD=injera_secure_pass_2026
POSTGRES_DB=injera_prod

# Cryptographic Token Secrets (Must be at least 32 random characters in production)
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_min_32_chars
JWT_REFRESH_SECRET=replace_with_another_cryptographically_secure_random_string_min_32_chars

# Docker & Startup Automation Flags
RUN_MIGRATIONS=true
SEED_SUPERADMIN=false

# Optional Superadmin Seed Credentials (used only if SEED_SUPERADMIN=true)
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=superadmin@bakery.et
SUPERADMIN_PHONE=+251911000000
SUPERADMIN_PASSWORD=BakeryRootSecure2026!
